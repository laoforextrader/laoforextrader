# Sanity CMS
NEXT_PUBLIC_SANITY_PROJECT_ID=your_project_id
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_API_TOKEN=your_token

# NextAuth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your_secret_here

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Email (for magic link)
EMAIL_SERVER=smtp://user:pass@smtp.gmail.com:587
EMAIL_FROM=noreply@laoforextrader.com

# Anthropic — for daily news summarization AND the /api/chat AI tutor.
# Chat uses claude-haiku-4-5 with prompt caching to keep cost low.
ANTHROPIC_API_KEY=sk-ant-...

# Chat widget — "Contact Admin" hand-off destinations shown in the
# confirmation card. Defaults to the existing TRS admin URLs if unset.
NEXT_PUBLIC_TRS_ADMIN=https://t.me/YourMoney_Admin
NEXT_PUBLIC_TRS_ADMIN_LINE=https://line.me/R/ti/p/@laoforextrader

# Two-way live chat over Telegram.
#   - TELEGRAM_BOT_TOKEN / ADMIN_TELEGRAM_CHAT_ID: when a visitor messages
#     admin via /api/chat/contact-admin, a notice is pushed to this chat.
#     If unset, the message only lands in Sanity (admin checks Studio).
#   - TELEGRAM_WEBHOOK_SECRET: shared secret for the INBOUND webhook
#     (/api/telegram/webhook). The admin REPLIES to the notice in Telegram;
#     Telegram echoes this secret in the X-Telegram-Bot-Api-Secret-Token
#     header so we can trust the request, then the reply is routed back to
#     the visitor's chat widget. Register the webhook once:
#       node scripts/set-telegram-webhook.mjs
TELEGRAM_BOT_TOKEN=
ADMIN_TELEGRAM_CHAT_ID=
TELEGRAM_WEBHOOK_SECRET=
# Public base URL used by the setWebhook script (no trailing slash).
PUBLIC_BASE_URL=https://laoforextrader.com
